name: Sign Shortcut
on:
  workflow_dispatch:
    inputs:
      filename:
        description: '文件名'
        required: true
        default: 'iCost自动记账.shortcut'

jobs:
  sign:
    runs-on: macos-14
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Prepare ASCII-named binary plist
        run: |
          set -x
          ls -la
          cp "${{ github.event.inputs.filename }}" input.shortcut
          plutil -convert binary1 -o input.shortcut input.shortcut
          file input.shortcut

      - name: Sign shortcut
        id: sign
        continue-on-error: true
        run: |
          set -x
          shortcuts sign --mode anyone --input input.shortcut --output signed.shortcut 2>&1 | tee "$GITHUB_WORKSPACE/sign-log.txt"
          ls -la signed.shortcut 2>&1 | tee -a "$GITHUB_WORKSPACE/sign-log.txt"

      - name: Upload result
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: sign-result
          path: |
            signed.shortcut
            sign-log.txt
          if-no-files-found: warn
